# ─────────────────────────────────────────────────────────────────────────────
# ASTECH Explorer — exemple de configuration locale / serveur.
# Copier en « .env » (non commité) :  copy .env.example .env   (Windows)
#                                      cp .env.example .env     (Linux)
# ─────────────────────────────────────────────────────────────────────────────

# --- Base Oracle ASTECH (PRODUCTION) -----------------------------------------
# Le mot de passe ne doit JAMAIS être commité : il vit uniquement dans .env.
ORACLE_ASTECH_HOST=10.103.130.25
ORACLE_ASTECH_PORT=1523
ORACLE_ASTECH_SERVICE=PIVRY01
ORACLE_ASTECH_USER=ASTECHIVR
ORACLE_ASTECH_PASSWORD=

# --- Base Oracle ASTECH (TEST / RECETTE, optionnelle) ------------------------
# Renseigner ces 5 valeurs active le profil « test » (sélecteur PROD/TEST dans l'UI).
# Même schéma que la prod ; sert d'abord aux essais d'écriture (indices, RH).
ORACLE_ASTECH_TEST_HOST=
ORACLE_ASTECH_TEST_PORT=1521
ORACLE_ASTECH_TEST_SERVICE=
ORACLE_ASTECH_TEST_USER=
ORACLE_ASTECH_TEST_PASSWORD=

# Profil sélectionné au démarrage (prod ou test).
ASTECH_ENV=prod

# --- Source Studio-RH (agents / organigramme) --------------------------------
STUDIO_RH_API_URL=https://studiorh.ivry.local
STUDIO_RH_API_KEY=
# Certificat interne (CA auto-signée) toléré par défaut ; mettre 0 pour vérifier.
# STUDIO_RH_INSECURE_TLS=0

# --- Écritures contrôlées ----------------------------------------------------
# 0 = lecture seule (défaut). 1 = autorise les écritures (indices, synchro RH,
# demandes). À activer sur la base de TEST en priorité.
ASTECH_ALLOW_WRITES=0

# --- Authentification Active Directory (APM de la Ville) ---------------------
# POST {APM_API_URL}/api/v1/ad/authenticate (header X-API-KEY, permission ad_auth).
# Voir GUIDE_NOUVELLE_APP_VILLE.md §3.2.
APM_API_URL=https://api.ivry.local
APM_API_KEY=
# 1 = impose la connexion AD pour accéder à l'application.
ASTECH_REQUIRE_AUTH=0
# Restriction d'accès par agent (listes séparées par des virgules, vides = tous).
# ASTECH_AGENT_ALLOW=
# ASTECH_AGENT_DENY=
# Agents promus administrateurs (liste séparée par des virgules, vides = défaut).
# ASTECH_ADMIN_USERS=
# Secret de signature des sessions (sinon généré aléatoirement au démarrage).
ASTECH_SESSION_SECRET=
# Durée de session en ms (défaut 8 h).
# ASTECH_SESSION_TTL_MS=28800000
# Compte administrateur LOCAL de secours (utilisable si l'AD est indisponible).
# Laisser vide pour utiliser le compte « admin » par défaut.
# ASTECH_LOCAL_ADMIN_LOGIN=admin
# ASTECH_LOCAL_ADMIN_PASSWORD_HASH=scrypt$salt$hash

# --- API publique référentiels (lecture seule) -------------------------------
# Clés au format "nom:cle,nom2:cle2". Durables : reprises à chaque redémarrage.
# Générer avec :  node apikey.js create --name "Partenaire"
ASTECH_API_KEYS=

# --- Divers (valeurs par défaut, à laisser sauf besoin) -----------------------
# PORT=8099
# ASTECH_LIMIT=50000
# ASTECH_API_DEFAULT_LIMIT=100
# ASTECH_API_MAX_LIMIT=1000
# ASTECH_KEYS_FILE=/app/data/api-keys.json
# ASTECH_JOURNAL_FILE=/app/data/indices-journal.jsonl
# ASTECH_RH_JOURNAL_FILE=/app/data/rh-journal.jsonl
